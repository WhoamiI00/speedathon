# Copy to .env.local (never commit it). Only NEXT_PUBLIC_* may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=          # only if LLM_PROVIDER=gemini. Free tier may train on data: use a paid key for real attendees
LLM_PROVIDER=            # optional: anthropic (default) | gemini
ANTHROPIC_API_KEY=       # default LLM (lib/llm.ts)
DIAL_API_KEY=
DIAL_NUMBER=
KEEWANO_API_KEY=        # ingestion (project key)
KEEWANO_PAT=            # MCP (personal access token)
DARWIN_API_KEY=
COOKIE_SECRET=          # any long random string: openssl rand -hex 32
